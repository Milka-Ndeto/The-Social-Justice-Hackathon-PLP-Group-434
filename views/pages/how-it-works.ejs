<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>How It Works - Volunteer Connect</title>
    <link rel="stylesheet" href="/css/styles.css"> <!-- Link to external CSS -->
</head>
<body>

    <!-- Header Section -->
    <%- include('../partials/header.ejs') %>

    <!-- How It Works Section -->
<section class="how-it-works">
    <h2>How It Works</h2>
    <p>Find opportunities, apply with ease, and make an impact!</p>
    <div class="steps">
        <a href="signup.html" class="step">
            <img src="Images & Icons/signup.png" alt="Sign Up">
            <h3>Sign Up</h3>
            <p>Create a profile.</p>
        </a>
        <a href="opportunities.html" class="step">
            <img src="Images & Icons/icons8-browse-30.png" alt="Browse Opportunities">
            <h3>Browse Opportunities</h3>
            <p>Search by interest or location.</p>
        </a>
        <a href="blog.html" class="step">
            <img src="Images & Icons/impacticon.png" alt="Make an Impact">
            <h3>Make an Impact</h3>
            <p>Connect and volunteer.</p>
        </a>
    </div>
</section>

    <!-- Call to Action Section -->
    <section class="cta">
        <h2>Ready to Get Started?</h2>
        <p>Join our community of passionate volunteers and make a difference today!</p>
        <a href="/signup" class="cta-button">Sign Up Now</a> <!-- Changed href to use route -->
    </section>

    <!-- Footer Section -->
    <%- include('../partials/footer.ejs') %>

</body>
</html>
